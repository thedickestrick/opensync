<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws the UI; this base theme only needs to be a Material 3 theme
         with no action bar and edge-to-edge friendly defaults. -->
    <style name="Theme.OpenSync" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
